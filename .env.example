# Copy this file to .env and replace every placeholder.
FLASK_SECRET_KEY=replace_with_a_long_random_secret

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=fixtrack
DB_USER=your_postgresql_username
DB_PASSWORD=your_postgresql_password

# Keep false for local HTTP. Set true when the app is served over HTTPS.
COOKIE_SECURE=false

# Set this to the actual email of the designated Admin before setup.
FIXTRACK_ADMIN_EMAIL=
FIXTRACK_ENV=development
